#!/usr/bin/env bash
#
# Checks that every entry under `## [Unreleased]` in CHANGELOG.md links to the pull request that made the change, such
# as `([#1](https://github.com/pehbehbeh/fil/pull/1))` at its end. CI and bin/release run it. See "Releasing" in
# AGENTS.md.
#
#   bin/check-changelog [FILE]
#
# FILE defaults to the CHANGELOG.md of the repository. Released sections aren't checked, they predate the rule.

set -euo pipefail

die() { printf 'check-changelog: %s\n' "$*" >&2; exit 1; }

root=$(cd "$(dirname "$0")/.." && pwd)
file=${1:-$root/CHANGELOG.md}
name=${1:-CHANGELOG.md}
[ -f "$file" ] || die "$name doesn't exist"

source_url=$(sed -n 's/^  @source_url "\(.*\)"$/\1/p' "$root/mix.exs")
[ -n "$source_url" ] || die "mix.exs has no @source_url line"

# An entry is a `- ` line plus its indented continuation lines, so the link counts on any of them. Prints the first line
# of each entry without one, with its line number. index() instead of a regex, so the dots in the URL match only dots.
missing=$(awk -v prefix="$source_url/pull/" -v name="$name" '
  function linked(text,   i) {
    while ((i = index(text, prefix)) > 0) {
      text = substr(text, i + length(prefix))
      if (text ~ /^[0-9]/) return 1
    }
    return 0
  }
  function flush() {
    if (entry != "" && !linked(entry)) print "  " name ":" line ": " first
    entry = ""
  }
  $0 == "## [Unreleased]" { s = 1; next }
  /^## |^\[/ { flush(); s = 0 }
  !s { next }
  /^- / { flush(); entry = first = $0; line = FNR; next }
  entry != "" && /^[ \t]+[^ \t]/ { entry = entry " " $0; next }
  { flush() }
  END { flush() }
' "$file")

if [ -n "$missing" ]; then
  printf 'check-changelog: these entries under Unreleased in %s have no link to their pull request:\n\n%s\n\n' \
    "$name" "$missing" >&2
  die "end each entry with one, such as ([#1]($source_url/pull/1)), once gh pr create returned the number"
fi
